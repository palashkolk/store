#!/bin/bash
set -e

# Run database setup automatically on container boot
if [ "$1" = "./bin/rails" ] && [ "$2" = "server" ]; then
  echo "== Running Production Database Migrations =="
  ./bin/rails db:prepare
fi

exec "$@"